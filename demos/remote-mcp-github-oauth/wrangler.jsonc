  {
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "telegram-bridge",
    "main": "src/index.ts",
    "compatibility_date": "2025-03-10",
    "compatibility_flags": ["nodejs_compat"],
    "kv_namespaces": [
      {
        "binding": "OAUTH_KV",
        "id": "5d993e99ac6447bf8dcd8ba71a498c1f"
      }
    ],
    "observability": {
      "enabled": true
    },
    "dev": {
      "port": 8788
    }
  }
